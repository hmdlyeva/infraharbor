# InfraHarbor local development configuration
# Copy to .env and provide values locally. Never commit .env.

POSTGRES_DB=infraharbor
POSTGRES_USER=infraharbor
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
ConnectionStrings__Database=
Runtime__DeploymentName=InfraHarbor Local
Runtime__PublicUrl=http://localhost:3000

# Owner bootstrap is disabled by default. When enabling it, provide a high-entropy
# secret of at least 32 characters and send it in X-InfraHarbor-Bootstrap-Token.
Bootstrap__Enabled=false
Bootstrap__Token=

# Authentication requires a deployment-specific signing secret containing at least
# 32 UTF-8 bytes. Never reuse the example/test values from CI in a real deployment.
Auth__Issuer=InfraHarbor
Auth__Audience=InfraHarbor.Api
Auth__SigningKey=
Auth__AccessTokenLifetimeSeconds=900
Auth__RefreshTokenLifetimeDays=30
Auth__ClockSkewSeconds=30
Auth__RefreshCookieName=infraharbor_refresh
# Local HTTP development needs false. HTTPS deployments should use true.
Auth__SecureCookies=false

# Credentials__MasterKey=
API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
